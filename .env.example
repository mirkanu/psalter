# PostgreSQL (psalter-db container — host port 5435)
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/psalter

# Airtable
AIRTABLE_PAT=your_personal_access_token_here
AIRTABLE_BASE_ID=appY3dB1EHtex0fUJ

# Tune score sheet images (served by Next.js at /tunes/<filename>)
# Path inside the Docker container where JPGs are stored
TUNES_DIR=/app/public/tunes
