# PostgreSQL (psalter-db container — host port 5435)
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/psalter

# Airtable
AIRTABLE_PAT=your_personal_access_token_here
AIRTABLE_BASE_ID=appY3dB1EHtex0fUJ

# Tune score sheet images (served by Next.js at /tunes/<filename>)
# Path inside the Docker container where JPGs are stored
TUNES_DIR=/app/public/tunes

# Anthropic API (for solfège OCR — scripts/ocr-solfege.ts)
PSALTER_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Better Auth (Phase 05.1)
# Generate secret with: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3005
# Admin account seed credentials (used by scripts/seed-admin.ts)
PSALTER_ADMIN_EMAIL=
PSALTER_ADMIN_PASSWORD=
