# PostgreSQL (psalter-db container — host port 5435)
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/psalter

# Airtable
AIRTABLE_PAT=your_personal_access_token_here
AIRTABLE_BASE_ID=appY3dB1EHtex0fUJ

# Cloudflare R2 (tune score sheet JPG storage)
# R2_ACCOUNT_ID: Cloudflare Dashboard → R2 → Account ID (right sidebar)
R2_ACCOUNT_ID=your_account_id_here
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY: Dashboard → R2 → Manage R2 API Tokens → Create Token
R2_ACCESS_KEY_ID=your_access_key_id_here
R2_SECRET_ACCESS_KEY=your_secret_access_key_here
# R2_BUCKET_NAME: name of the R2 bucket you created (e.g. psalter)
R2_BUCKET_NAME=psalter
# R2_PUBLIC_URL: public base URL for the bucket (e.g. https://pub-xxx.r2.dev)
R2_PUBLIC_URL=https://your-bucket.r2.dev
