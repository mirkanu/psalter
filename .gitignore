# Environment variables — NEVER commit
.env
.env.local
.env.*.local

# Next.js
.next/
out/
build/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Drizzle
drizzle/migrations/

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp

# Claude local settings
.claude/settings.local.json

# Script output (runtime-generated, can be large)
scripts/output/*.json

# Build-time deploy info — regenerated on every `npm run build` via
# scripts/capture-deploy-info.ts (wired into `prebuild`). Committing it
# would create a second modified file on every build for no value.
data/deploy-info.json
src/generated/build-info.json

# UAT screenshots pushed to Telegram during verification plans (runtime-generated)
.tmp-uat/

# Phase 13 tune-image-compression working directories (large image binaries — never commit)
public/tunes-compressed/
public/tunes-samples/
public/tunes-old/

# .planning operational history — may contain infra-specific details
# Keep: ROADMAP.md, PROJECT.md, REQUIREMENTS.md, milestones/, seeds/, notes/, research/, todos/
.planning/phases/
.planning/quick/
.planning/debug/
.planning/threads/
.planning/config.json
